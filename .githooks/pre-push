#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-only
# Before each push: formatting (seconds). Lints and tests: scripts/check.sh.
# Switch on once per clone: git config core.hooksPath .githooks
# Skip once: git push --no-verify
cd "$(git rev-parse --show-toplevel)" || exit 1
if ! cargo fmt --all --check >/dev/null 2>&1; then
  echo "pre-push: code not formatted. Run: cargo fmt --all   (then commit)" >&2
  exit 1
fi
