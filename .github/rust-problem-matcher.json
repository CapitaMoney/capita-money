{
  "problemMatcher": [
    {
      "owner": "rustc",
      "pattern": [
        {
          "regexp": "^\\s*error(\\[(\\S*)\\])?: (.*)$",
          "code": 2,
          "message": 3
        },
        {
          "regexp": "^\\s*-->\\s(\\S+):(\\d+):(\\d+)$",
          "file": 1,
          "line": 2,
          "column": 3
        }
      ]
    },
    {
      "owner": "rust-test",
      "pattern": [
        {
          "regexp": "^thread '(.*)'.* panicked at (\\S+):(\\d+):(\\d+):$",
          "message": 1,
          "file": 2,
          "line": 3,
          "column": 4
        }
      ]
    }
  ]
}
